{
  "name": "chatcarry",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Carry context between ChatGPT, Claude, and Gemini without a server.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run compile && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "^1.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0",
    "wxt": "^0.21.3"
  }
}
